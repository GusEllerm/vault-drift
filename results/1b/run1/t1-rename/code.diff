     ceiling = block_s - TASK_CEILING_MARGIN_S
     if ceiling <= 0:  # missing/tiny walltime (e.g. LocalFacility has none) -> a safe default
         ceiling = max(SYNC_WAIT_S + TASK_CEILING_MARGIN_S, 300.0)
